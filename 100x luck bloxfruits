-- =========================================================
-- FUNÇÃO PARA ATUALIZAR COR
-- =========================================================

local function updateColor(color)

    currentColor = color

    logoStroke.Color = color
    menuStroke.Color = color

    for _, object in ipairs(menu:GetChildren()) do

        if object:IsA("TextLabel") then

            if object.Text == "LUCK"
            or object.Text == "CONFIGURAÇÃO" then

                object.TextColor3 = color

            elseif object.Text == "Current Luck: 1x"
            or object.Text == "Current Luck: 10x"
            or object.Text == "Current Luck: 100x"
            or object.Text == "Current Luck: 1000x" then

                object.TextColor3 = color

            end

        end

    end

end

