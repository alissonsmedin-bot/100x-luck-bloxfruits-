-- =========================================================
-- ARRASTO SUAVE DA LOGO
-- =========================================================

local draggingLogo = false
local dragStart
local targetLogoPosition

local function getMousePosition(input)

    return Vector2.new(
        input.Position.X,
        input.Position.Y
    )

end

logo.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        draggingLogo = true

        dragStart = getMousePosition(input)
        targetLogoPosition = logo.Position

    end

end)

logo.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        draggingLogo = false

    end

end)

UIS.InputChanged:Connect(function(input)

    if not draggingLogo then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local current = getMousePosition(input)
    local delta = current - dragStart

    targetLogoPosition = UDim2.new(
        targetLogoPosition.X.Scale,
        targetLogoPosition.X.Offset + delta.X,
        targetLogoPosition.Y.Scale,
        targetLogoPosition.Y.Offset + delta.Y
    )

    dragStart = current

end)

-- =========================================================
-- MOVIMENTO SUAVE
-- =========================================================

RunService.RenderStepped:Connect(function()

    if targetLogoPosition then

        local current = logo.Position

        logo.Position = UDim2.new(
            current.X.Scale,
            current.X.Offset + (targetLogoPosition.X.Offset - current.X.Offset) * 0.25,

            current.Y.Scale,
            current.Y.Offset + (targetLogoPosition.Y.Offset - current.Y.Offset) * 0.25
        )

    end

end)

